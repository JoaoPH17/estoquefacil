# Copie este arquivo para ".env" e ajuste os valores.

# Banco de dados.
# Desenvolvimento: SQLite em arquivo (não precisa instalar nada).
DATABASE_URL=sqlite:///./estoquefacil.db
# PostgreSQL local (docker compose up -d db):
# DATABASE_URL=postgresql://estoquefacil:estoquefacil@localhost:5432/estoquefacil
# PostgreSQL na nuvem: cole a URL fornecida pelo provedor (Neon, Supabase, Render...).
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Endereços do frontend que podem acessar a API, separados por vírgula.
CORS_ORIGINS=http://localhost:5173

# Cadastra 15 produtos de exemplo se o banco estiver vazio. Use false em produção.
SEED_DATA=true

# Login do sistema (padrão: usuário adm123, senha 012345). Troque em produção.
ADMIN_USUARIO=adm123
ADMIN_SENHA=012345
# Chave usada para assinar o login. Em produção, use um valor longo e aleatório.
SECRET_KEY=troque-esta-chave-em-producao
